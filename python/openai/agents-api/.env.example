# OpenAI application key: creates and streams sessions and runs model inference.
# Stays on your machine; never enters the sandbox.
# Permissions: api.agents.read, api.agents.write, api.responses.write.
OPENAI_API_KEY=your_openai_application_key

# OpenAI executor key: the only credential passed into the sandbox, where
# agent-generated code can read it. Create it as a restricted environment key.
# Permissions: api.agents.environments.connect only (every other permission None).
OPENAI_EXECUTOR_API_KEY=your_openai_executor_key

# Daytona API key: https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=your_daytona_key
