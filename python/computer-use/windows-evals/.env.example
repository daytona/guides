# Copy this file to .env in this directory and fill in values.
# Scripts load it automatically; already-exported shell variables take precedence.

# Required: Daytona API key, from https://app.daytona.io/dashboard/keys
export DAYTONA_API_KEY=

# Optional: only needed when targeting a non-default API endpoint
# export DAYTONA_API_URL=https://app.daytona.io/api

# Required only for `harness.py --agent claude` (Claude Code CLI)
# export ANTHROPIC_API_KEY=

# Required only for `harness.py --agent codex` (Codex CLI)
# export OPENAI_API_KEY=
