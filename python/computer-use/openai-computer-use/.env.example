# OpenAI API key: authenticates the model calls that drive the computer-use
# loop. Stays on your machine; never enters the sandbox.
OPENAI_API_KEY=your_openai_api_key

# OpenAI model: must be a model that supports the native `computer` tool.
OPENAI_MODEL=gpt-6-astra

# Daytona API key: https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=your_daytona_key
