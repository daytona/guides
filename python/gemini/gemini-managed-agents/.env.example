# Used by create_environment.py and run_agent.py (your application side).
# Never sent to a sandbox.
GEMINI_API_KEY=

# Printed by create_environment.py. The environment key is returned only once.
GEMINI_ENVIRONMENT_ID=
GEMINI_ENVIRONMENT_KEY=

# Used by build_snapshot.py, worker.py, and provision_sandbox.py.
DAYTONA_API_KEY=

# Optional.
# GEMINI_AGENT=antigravity-preview-09-2026
# Override the Dockerfile-hash snapshot name (gemini-managed-agents-<sha8>).
# SNAPSHOT_NAME=
