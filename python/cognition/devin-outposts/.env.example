# Devin Outposts machine-serving token. `outposts-connect` writes the service
# user's token here; manual setups may fill it directly. The queue client uses
# it for list, watch, claim, and release. Do not treat it as interchangeable
# with a generic DEVIN_API_TOKEN used for unrelated Devin API scripts.
DEVIN_OUTPOSTS_TOKEN=replace-with-devin-outposts-token

# Devin API base without /opbeta. `outposts-connect` writes it here; manual
# setups may fill it directly. The queue client appends /opbeta.
DEVIN_API_URL=https://api.devin.ai

# Daytona SDK token used by the snapshot builder and orchestrator.
DAYTONA_API_KEY=replace-with-daytona-api-key

# Outpost ID written by `outposts-connect` or filled in after manual outpost
# creation.
OUTPOST_ID=outpost_env_replace_with_outpost_id

# Snapshot used by the orchestrator for Linux outposts. Leave blank while running
# the snapshot builder if you want the Dockerfile hash-derived name, then copy
# the printed snapshot name here before starting the orchestrator.
SNAPSHOT_NAME=

# Runtime concurrency and local state.
MAX_CONCURRENT_SESSIONS=5
ACCEPTOR_ID=
STATE_DIR=~/.devin-outposts-orchestrator

# Sandbox workdir used for worker launch and optional repo pre-clone.
WORKDIR=/home/daytona/workspace

# Optional repo pre-clone support. Configure this for repo-dependent sessions
# until your tenant proves automatic repo checkout on empty worker sandboxes.
REPOS=
GIT_USERNAME=
GIT_TOKEN=

# Worker browser path inside Linux sandboxes.
DEVIN_CHROME_PATH=/usr/bin/chromium

# Windows outposts only: sandbox workdir and browser path inside Windows
# sandboxes. The defaults match the snapshot built by build-devin-outposts-windows-snapshot.
WINDOWS_WORKDIR='C:\repos'
DEVIN_WINDOWS_CHROME_PATH='C:\Program Files\Google\Chrome\Application\chrome.exe'
