# Operator settings. Copy this file to .env and replace these safe placeholders.
DAYTONA_API_KEY=replace-with-your-daytona-api-key
SNAPSHOT_NAME=
CURSOR_API_KEY=replace-with-your-cursor-service-account-key

# The Cursor controller supplies these claim values when it invokes the spawn command.
# Do not set them manually for normal controller use.
# CURSOR_AGENT_WORKER_ID=cursor-supplied-worker-id
# CURSOR_POOL=cursor-supplied-pool
# CURSOR_REQUEST_ID=cursor-supplied-request-id

# Optional host/controller timing settings, in seconds.
CURSOR_WORKER_IDLE_RELEASE_TIMEOUT=900
MONITOR_POLL_SECONDS=5
SANDBOX_CREATE_TIMEOUT_SECONDS=120
SANDBOX_LAUNCH_TIMEOUT_SECONDS=60
