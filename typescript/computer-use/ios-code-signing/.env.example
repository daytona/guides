USE_COMPUTER_API_KEY=
USE_COMPUTER_RESERVATION_ID=

# Apple Developer Program team that owns the signing certificate/profile
APPLE_TEAM_ID=
# Bundle identifier to sign the app as, e.g. com.yourteam.SignDemo
APPLE_BUNDLE_ID=

# App Store Connect API key, used for non-interactive signing (no Apple ID login, no 2FA)
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
# Local path to the downloaded AuthKey_<APPLE_API_KEY_ID>.p8 file — never commit this file
APPLE_API_KEY_PATH=

# "development" (default) or "ad-hoc" — see README for the difference
APPLE_EXPORT_METHOD=
