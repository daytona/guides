# Required: Daytona API key, from https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=

# Required: Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model the drawing loop uses
# MODEL=claude-sonnet-5-5

# Optional: cap the number of model/tool iterations (default: 120)
# MAX_TURNS=120

# Optional: save a final desktop screenshot after the model finishes
# OUTPUT_PATH=./claude-draws.png
